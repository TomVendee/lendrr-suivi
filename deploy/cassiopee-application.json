{
  "name": "iplanner",
  "image": { "repository": "ghcr.io/tomvendee/lendrr-suivi", "tag": "REMPLACER" },
  "replicas": 1,
  "resources": { "limits": { "cpu": "200m", "memory": "256Mi" } },
  "service": { "port": 80, "target_port": 8080 },
  "env": {
    "DATABASE_URL": "REMPLACER",
    "PORT": "8080",
    "APP_URL": "https://iplanner.cassiopee.siops.sigl.epita.fr"
  },
  "probes": { "readiness": { "enabled": true, "path": "/ready", "port": 8080 } }
}
